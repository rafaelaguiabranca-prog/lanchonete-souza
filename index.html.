<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lanchonete Souza — PDV &amp; Gestão</title>
  <style>
    :root {
      --bg: #fdf6f0;
      --surface: #ffffff;
      --surface-soft: #fff7ed;
      --border: #edd9c6;
      --text: #2c1810;
      --muted: #6e4f3f;
      --primary: #ea580c;
      --primary-dark: #c2410c;
      --primary-light: #ffedd5;
      --brown: #4a2511;
      --brown-soft: #f5ebe0;
      --success: #15803d;
      --success-bg: #dcfce7;
      --danger: #b91c1c;
      --danger-bg: #fee2e2;
      --warning: #b45309;
      --warning-bg: #fef3c7;
      --info: #1d4ed8;
      --info-bg: #dbeafe;
      --radius: 14px;
      --shadow: 0 4px 16px rgba(74, 37, 17, 0.08);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.45;
      -webkit-font-smoothing: antialiased;
    }

    header {
      background: linear-gradient(135deg, var(--brown) 0%, #7c2d12 55%, var(--primary) 100%);
      color: #fff;
      padding: 14px 18px;
      position: sticky;
      top: 0;
      z-index: 40;
      box-shadow: 0 3px 12px rgba(44, 24, 16, 0.22);
    }

    .header-inner {
      max-width: 1360px;
      margin: 0 auto;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-logo {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: #fff;
      color: var(--primary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 20px;
      overflow: hidden;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    .brand-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .brand h1 {
      margin: 0;
      font-size: 1.25rem;
      letter-spacing: -0.01em;
    }

    .brand p {
      margin: 2px 0 0;
      font-size: 0.8rem;
      color: #ffedd5;
    }

    .header-status {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
      font-size: 0.78rem;
    }

    .status-pill {
      background: rgba(255,255,255,0.16);
      border: 1px solid rgba(255,255,255,0.25);
      padding: 5px 10px;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    nav.tabs {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 74px;
      z-index: 35;
      overflow-x: auto;
      white-space: nowrap;
      -webkit-overflow-scrolling: touch;
    }

    .tabs-inner {
      max-width: 1360px;
      margin: 0 auto;
      display: flex;
      gap: 4px;
      padding: 6px 12px;
    }

    .tab-btn {
      border: none;
      background: transparent;
      color: var(--muted);
      font-weight: 700;
      font-size: 0.9rem;
      padding: 11px 15px;
      border-radius: 10px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      transition: all 0.15s ease;
    }

    .tab-btn:hover {
      background: var(--surface-soft);
      color: var(--brown);
    }

    .tab-btn.active {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 2px 8px rgba(234, 88, 12, 0.3);
    }

    main {
      max-width: 1360px;
      margin: 0 auto;
      padding: 18px 14px 48px;
    }

    .view { display: none; }
    .view.active { display: block; }

    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .grid-pdv {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 16px;
      align-items: start;
    }

    @media (max-width: 980px) {
      .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid-2, .grid-pdv { grid-template-columns: 1fr; }
      nav.tabs { top: 106px; }
    }

    @media (max-width: 520px) {
      .grid-4 { grid-template-columns: 1fr; }
      .tab-btn { padding: 10px 12px; font-size: 0.85rem; }
    }

    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px;
      box-shadow: var(--shadow);
      margin-bottom: 16px;
    }

    .card-title {
      margin: 0 0 12px;
      font-size: 1.05rem;
      color: var(--brown);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
    }

    .kpi-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-left: 5px solid var(--primary);
      border-radius: var(--radius);
      padding: 14px 16px;
      box-shadow: var(--shadow);
    }

    .kpi-card.brown { border-left-color: var(--brown); }
    .kpi-card.green { border-left-color: var(--success); }
    .kpi-card.red { border-left-color: var(--danger); }

    .kpi-label {
      font-size: 0.82rem;
      color: var(--muted);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .kpi-value {
      font-size: 1.55rem;
      font-weight: 800;
      margin: 4px 0 2px;
      color: var(--text);
    }

    .kpi-sub {
      font-size: 0.78rem;
      color: var(--muted);
    }

    label {
      display: block;
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--brown);
      margin-bottom: 4px;
    }

    input, select, textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1.5px solid #dcc4ad;
      border-radius: 10px;
      font-size: 0.96rem;
      font-family: inherit;
      background: #fff;
      color: var(--text);
    }

    input:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.15);
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 10px;
      margin-bottom: 12px;
    }

    .btn {
      border: none;
      border-radius: 10px;
      padding: 11px 15px;
      font-size: 0.92rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: transform 0.08s ease, opacity 0.15s ease, background 0.15s ease;
      text-decoration: none;
    }

    .btn:active { transform: scale(0.98); }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-primary:hover { background: var(--primary-dark); }
    .btn-brown { background: var(--brown); color: #fff; }
    .btn-brown:hover { background: #33180a; }
    .btn-success { background: var(--success); color: #fff; }
    .btn-success:hover { background: #166534; }
    .btn-danger { background: var(--danger); color: #fff; }
    .btn-danger:hover { background: #991b1b; }
    .btn-whatsapp { background: #16a34a; color: #fff; }
    .btn-whatsapp:hover { background: #15803d; }
    .btn-outline {
      background: #fff;
      color: var(--brown);
      border: 1.5px solid #d4b89c;
    }
    .btn-outline:hover { background: var(--surface-soft); }
    .btn-sm { padding: 7px 10px; font-size: 0.82rem; border-radius: 8px; }
    .btn-block { width: 100%; }

    .badge {
      display: inline-block;
      padding: 3px 9px;
      border-radius: 999px;
      font-size: 0.76rem;
      font-weight: 700;
    }

    .badge-ok { background: var(--success-bg); color: var(--success); }
    .badge-warn { background: var(--warning-bg); color: var(--warning); }
    .badge-danger { background: var(--danger-bg); color: var(--danger); }
    .badge-info { background: var(--info-bg); color: var(--info); }
    .badge-brown { background: var(--brown-soft); color: var(--brown); }

    .alert-box {
      padding: 11px 13px;
      border-radius: 10px;
      margin-bottom: 10px;
      border-left: 4px solid var(--warning);
      background: var(--warning-bg);
      color: #451a03;
      font-size: 0.88rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      flex-wrap: wrap;
    }

    .alert-box.danger {
      border-left-color: var(--danger);
      background: var(--danger-bg);
      color: #450a0a;
    }

    .alert-box.info {
      border-left-color: var(--info);
      background: var(--info-bg);
      color: #172554;
    }

    .table-wrap {
      width: 100%;
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: 10px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
      background: #fff;
    }

    th, td {
      padding: 10px 10px;
      text-align: left;
      border-bottom: 1px solid #f0e2d4;
      vertical-align: middle;
    }

    th {
      background: var(--brown-soft);
      color: var(--brown);
      font-weight: 700;
      white-space: nowrap;
    }

    tr:last-child td { border-bottom: none; }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(165px, 1fr));
      gap: 10px;
      max-height: 460px;
      overflow-y: auto;
      padding-right: 2px;
    }

    .prod-tile {
      border: 1.5px solid var(--border);
      background: var(--surface-soft);
      border-radius: 12px;
      padding: 11px;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 6px;
      text-align: left;
      transition: all 0.12s ease;
    }

    .prod-tile:hover:not(:disabled) {
      border-color: var(--primary);
      background: var(--primary-light);
      transform: translateY(-1px);
    }

    .prod-tile:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .prod-tile-name {
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--text);
    }

    .prod-tile-price {
      font-weight: 800;
      font-size: 1.05rem;
      color: var(--primary-dark);
    }

    .prod-tile-stock {
      font-size: 0.76rem;
      color: var(--muted);
    }

    .cart-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 9px 0;
      border-bottom: 1px dashed #e5ccb5;
    }

    .qty-box {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .qty-btn {
      width: 28px;
      height: 28px;
      border-radius: 7px;
      border: 1px solid #d4b89c;
      background: #fff;
      font-weight: 800;
      cursor: pointer;
      color: var(--brown);
    }

    .totals-box {
      background: var(--surface-soft);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 12px;
      margin: 12px 0;
    }

    .total-line {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6px;
      font-size: 0.92rem;
    }

    .total-line.final {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--brown);
      border-top: 1px solid #e5ccb5;
      padding-top: 8px;
      margin-top: 6px;
      margin-bottom: 0;
    }

    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(28, 14, 7, 0.62);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 14px;
      z-index: 100;
    }

    .modal-backdrop.open { display: flex; }

    .modal {
      background: #fff;
      border-radius: 16px;
      max-width: 720px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      padding: 20px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.35);
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 10px;
      margin-bottom: 14px;
    }

    .modal-header h3 {
      margin: 0;
      color: var(--brown);
      font-size: 1.1rem;
    }

    .receipt-preview {
      background: #fffef9;
      border: 1px dashed #8c6239;
      border-radius: 10px;
      padding: 14px;
      font-family: "Courier New", Courier, monospace;
      font-size: 0.85rem;
      white-space: pre-wrap;
      color: #1f140d;
      margin-bottom: 14px;
    }

    .toast {
      position: fixed;
      bottom: 18px;
      right: 18px;
      background: var(--brown);
      color: #fff;
      padding: 12px 16px;
      border-radius: 12px;
      font-weight: 700;
      font-size: 0.9rem;
      box-shadow: 0 8px 24px rgba(0,0,0,0.25);
      z-index: 200;
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.2s ease;
      pointer-events: none;
      max-width: 90vw;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    .filter-pills {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-bottom: 12px;
    }

    .pill-btn {
      padding: 7px 12px;
      border-radius: 999px;
      border: 1px solid #d4b89c;
      background: #fff;
      color: var(--brown);
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
    }

    .pill-btn.active {
      background: var(--brown);
      color: #fff;
      border-color: var(--brown);
    }

    /* Impressão térmica 58mm, 80mm e A4 */
    @media print {
      body * { visibility: hidden; }
      #printArea, #printArea * { visibility: visible; }
      #printArea {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        padding: 0;
        margin: 0;
        font-family: "Courier New", Courier, monospace;
        color: #000;
      }
      body.print-58 #printArea { width: 58mm; font-size: 10px; }
      body.print-80 #printArea { width: 80mm; font-size: 11.5px; }
      body.print-a4 #printArea { width: 100%; max-width: 190mm; font-size: 13px; }
      @page { margin: 4mm; }
    }
    #printArea { display: none; }
    @media print { #printArea { display: block; } }
  </style>
</head>
<body>
  <header>
    <div class="header-inner">
      <div class="brand">
        <div class="brand-logo" id="headerLogo">LS</div>
        <div>
          <h1 id="headerStoreName">Lanchonete Souza</h1>
          <p id="headerSubtitle">PDV de Revenda • Estoque, Caixa, Fiados &amp; Cobranças</p>
        </div>
      </div>
      <div class="header-status">
        <span class="status-pill" id="storageBadge">💾 Salvamento Ativo</span>
        <span class="status-pill" id="cloudBadge">☁️ Local (IndexedDB)</span>
        <span class="status-pill" id="clockBadge">--/--/----</span>
      </div>
    </div>
  </header>

  <nav class="tabs" aria-label="Navegação principal">
    <div class="tabs-inner">
      <button class="tab-btn active" data-tab="painel" onclick="switchTab('painel')">📊 Painel</button>
      <button class="tab-btn" data-tab="vendas" onclick="switchTab('vendas')">🛒 Vendas (PDV)</button>
      <button class="tab-btn" data-tab="estoque" onclick="switchTab('estoque')">📦 Estoque</button>
      <button class="tab-btn" data-tab="fiados" onclick="switchTab('fiados')">📒 Fiados &amp; Extrato</button>
      <button class="tab-btn" data-tab="cobrancas" onclick="switchTab('cobrancas')">📅 Cobranças</button>
      <button class="tab-btn" data-tab="caixa" onclick="switchTab('caixa')">💰 Caixa</button>
      <button class="tab-btn" data-tab="config" onclick="switchTab('config')">⚙️ Ajustes &amp; Backup</button>
    </div>
  </nav>

  <main>
    <!-- 1. PAINEL INICIAL -->
    <section id="view-painel" class="view active">
      <div class="grid-4" style="margin-bottom:16px;">
        <div class="kpi-card">
          <div class="kpi-label">Vendas Hoje</div>
          <div class="kpi-value" id="kpiVendasHoje">R$ 0,00</div>
          <div class="kpi-sub" id="kpiQtdVendasHoje">0 vendas realizadas</div>
        </div>
        <div class="kpi-card green">
          <div class="kpi-label">Saldo Atual do Caixa</div>
          <div class="kpi-value" id="kpiSaldoCaixa">R$ 0,00</div>
          <div class="kpi-sub">Entradas − Saídas registradas</div>
        </div>
        <div class="kpi-card brown">
          <div class="kpi-label">A Receber (Fiados)</div>
          <div class="kpi-value" id="kpiTotalFiados">R$ 0,00</div>
          <div class="kpi-sub" id="kpiClientesDevedores">0 clientes com saldo</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Produtos Cadastrados</div>
          <div class="kpi-value" id="kpiTotalProdutos">0</div>
          <div class="kpi-sub" id="kpiUnidadesEstoque">0 unidades em estoque</div>
        </div>
      </div>

      <div class="grid-2">
        <div>
          <div class="card">
            <h2 class="card-title">⚠️ Avisos de Estoque Baixo</h2>
            <div id="painelEstoqueBaixo"></div>
          </div>

          <div class="card">
            <h2 class="card-title">⏰ Avisos de Cobranças Vencidas e do Dia</h2>
            <div id="painelCobrancasAlerta"></div>
          </div>
        </div>

        <div class="card">
          <h2 class="card-title">
            <span>🧾 Resumo das Últimas Vendas</span>
            <button class="btn btn-sm btn-primary" onclick="switchTab('vendas')">+ Nova Venda</button>
          </h2>
          <div id="painelUltimasVendas"></div>
        </div>
      </div>
    </section>

    <!-- 2. VENDAS (PDV) -->
    <section id="view-vendas" class="view">
      <div class="grid-pdv">
        <div class="card">
          <h2 class="card-title">Selecionar Produtos (Revenda)</h2>
          <div class="form-row">
            <div>
              <label for="pdvSearch">Buscar produto</label>
              <input type="text" id="pdvSearch" placeholder="Digite nome ou categoria..." oninput="renderPdvProducts()" />
            </div>
            <div>
              <label for="pdvCategory">Categoria</label>
              <select id="pdvCategory" onchange="renderPdvProducts()">
                <option value="ALL">Todas as categorias</option>
              </select>
            </div>
          </div>
          <div class="product-grid" id="pdvProductGrid"></div>
        </div>

        <div class="card">
          <h2 class="card-title">
            <span>Carrinho da Venda</span>
            <button class="btn btn-sm btn-outline" onclick="clearCart()">Limpar</button>
          </h2>
          <div id="cartItemsList"></div>

          <div class="totals-box">
            <div class="total-line">
              <span>Subtotal</span>
              <strong id="cartSubtotal">R$ 0,00</strong>
            </div>
            <div class="form-row" style="margin:8px 0;">
              <div>
                <label for="cartDiscount">Desconto (R$)</label>
                <input type="number" id="cartDiscount" min="0" step="0.01" value="0.00" oninput="renderCart()" />
              </div>
              <div>
                <label for="salePaymentMethod">Forma de Pagamento</label>
                <select id="salePaymentMethod" onchange="onPaymentMethodChange()">
                  <option value="Dinheiro">💵 Dinheiro</option>
                  <option value="Pix">💠 Pix</option>
                  <option value="Cartão">💳 Cartão</option>
                  <option value="Fiado">📒 Fiado (Caderneta)</option>
                </select>
              </div>
            </div>

            <div id="dinheiroFields" style="margin-bottom:8px;">
              <label for="cashReceived">Valor Recebido em Dinheiro (R$)</label>
              <input type="number" id="cashReceived" min="0" step="0.01" placeholder="0,00" oninput="renderCart()" />
              <div class="total-line" style="margin-top:6px;">
                <span>Troco:</span>
      
